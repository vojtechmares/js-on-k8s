{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "js-on-k8s",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker must see every request to negotiate on the Accept header.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.js-on-k8s.dev", "custom_domain": true },
    { "pattern": "js-on-k8s.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
