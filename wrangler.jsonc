{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "js-on-k8s",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only HTML page URLs need the Worker (Accept: text/markdown negotiation).
    // Everything else, including the .md twins, is served straight from the
    // asset store: free, cached at the edge, headers from public/_headers.
    "run_worker_first": ["/", "/recipes", "/recipes/*", "!/recipes/*.md"]
  },
  // Only the custom domains below serve the site; no workers.dev copy to get indexed.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "js-on-k8s.dev", "custom_domain": true },
    { "pattern": "www.js-on-k8s.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
