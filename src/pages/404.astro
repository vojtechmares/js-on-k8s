---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Page not found.">
  <article class="prose">
    <h1>404 - not found</h1>
    <pre>{`$ kubectl get page
Error from server (NotFound): pages "${'<this one>'}" not found`}</pre>
    <p>Try the <a href="/">home page</a> or the <a href="/recipes">recipes</a>.</p>
  </article>
</Base>
