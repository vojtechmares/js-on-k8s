---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecipeList from '../../components/RecipeList.astro';
import { SITE, FULL_EXAMPLE_URL, exampleUrl, recipeUrl } from '../../lib/site';
import { sortedRecipes, childrenOf, parentId, type Recipe } from '../../lib/markdown';

export async function getStaticPaths() {
  const recipes = await sortedRecipes();
  const byId = new Map(recipes.map((r) => [r.id, r]));
  return recipes.map((recipe, i) => ({
    params: { slug: recipe.id },
    props: {
      recipe,
      prev: recipes[i - 1] ?? null,
      next: recipes[i + 1] ?? null,
      parent: parentId(recipe) ? (byId.get(parentId(recipe)!) ?? null) : null,
      children: childrenOf(recipe, recipes),
    },
  }));
}

interface Props {
  recipe: Recipe;
  prev: Recipe | null;
  next: Recipe | null;
  parent: Recipe | null;
  children: Recipe[];
}

const { recipe, prev, next, parent, children } = Astro.props;
const { Content } = await render(recipe);
const url = `${SITE.url}${recipeUrl(recipe.id)}`;
const updated = recipe.data.updated;

const crumbs = [
  { name: SITE.short, item: `${SITE.url}/` },
  { name: 'Recipes', item: `${SITE.url}/recipes/` },
  ...(parent ? [{ name: parent.data.title, item: `${SITE.url}${recipeUrl(parent.id)}` }] : []),
  { name: recipe.data.title, item: url },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: recipe.data.title,
    description: recipe.data.description,
    url,
    mainEntityOfPage: url,
    dateModified: updated.toISOString(),
    inLanguage: 'en',
    keywords: recipe.data.tags.join(', '),
    author: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
    publisher: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
    isPartOf: parent
      ? { '@type': 'TechArticle', headline: parent.data.title, url: `${SITE.url}${recipeUrl(parent.id)}` }
      : { '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/` },
    encoding: { '@type': 'MediaObject', encodingFormat: 'text/markdown', contentUrl: `${url.replace(/\/$/, '')}.md` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })),
  },
];
---

<Base title={recipe.data.title} description={recipe.data.description} jsonLd={jsonLd} ogType="article" updated={updated}>
  <article class="prose">
    <p class="text-xs text-zinc-500">
      <a href="/recipes/" class="text-zinc-500">recipes</a>
      {parent && <> / <a href={recipeUrl(parent.id)} class="text-zinc-500">{parent.id}</a></>}
      {' / '}{recipe.id.split('/').pop()}
    </p>
    <h1>{recipe.data.title}</h1>
    <p class="text-zinc-600">{recipe.data.description}</p>
    <Content />

    {children.length > 0 && (
      <>
        <h2>In this section</h2>
        <RecipeList recipes={children.map((c) => c)} />
      </>
    )}

    <h2>See it applied</h2>
    <ul>
      {recipe.data.example && (
        <li>
          <a href={exampleUrl(recipe.data.example)} rel="noopener">{recipe.data.example}</a> in the repository
        </li>
      )}
      <li>
        <a href={FULL_EXAMPLE_URL} rel="noopener">examples/full</a> - every recipe applied to one app
      </li>
    </ul>
    <p class="text-xs text-zinc-500">
      Updated {updated.toISOString().slice(0, 10)}
      {recipe.data.tags.length > 0 && <> &middot; tags: {recipe.data.tags.join(', ')}</>}
      &middot; <a href={`${SITE.repo}/blob/main/src/content/recipes/${recipe.id}.md`} class="text-zinc-500" rel="noopener">edit on GitHub</a>
    </p>
  </article>

  <nav class="prose mt-10 flex flex-wrap justify-between gap-4 text-sm" aria-label="Recipe navigation">
    <span>{prev && <a href={recipeUrl(prev.id)} rel="prev">&lt;- {prev.data.title}</a>}</span>
    <span>{next && <a href={recipeUrl(next.id)} rel="next">{next.data.title} -&gt;</a>}</span>
  </nav>
</Base>
