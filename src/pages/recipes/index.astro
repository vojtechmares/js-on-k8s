---
import Base from '../../layouts/Base.astro';
import RecipeList from '../../components/RecipeList.astro';
import { SITE, FULL_EXAMPLE_URL } from '../../lib/site';
import { sortedRecipes } from '../../lib/markdown';

const recipes = await sortedRecipes();
const title = 'Recipes';
const description = `${recipes.length} focused recipes for running Node.js on Kubernetes. One thing per recipe: images, signals, probes, manifests, Helm, Kustomize.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${title} - ${SITE.name}`,
    url: `${SITE.url}/recipes/`,
    description,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.short, item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: title, item: `${SITE.url}/recipes/` },
    ],
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="prose">
    <h1>{title}</h1>
    <p>
      One thing per recipe. Read them in order for a full picture, or jump to the one you need.
      All of them are applied together in the{' '}
      <a href={FULL_EXAMPLE_URL} rel="noopener">full example</a>.
    </p>
    <RecipeList recipes={recipes} />
  </article>
</Base>
